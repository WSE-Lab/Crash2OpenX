# Copy to .env.local and fill in. Loaded automatically by web_app.py,
# coordinator.py, extract_source.py and carla_remote.py.

# LLM/VLM inference (OpenAI-compatible endpoint; default base_url is
# https://openrouter.ai/api/v1, see --base-url flags to change it).
OPENROUTER_API_KEY=sk-or-...

# Execution transport: local (Dockerized CARLA on this machine, default)
# or remote (legacy ssh driver, needs CARLA_REMOTE_* below).
CARLA_MODE=local

# Local mode overrides (all optional; defaults in tools/carla_local.py):
# CARLA_LOCAL_CONTAINER=carla-0916
# CARLA_LOCAL_RPC_PORT=2000

# Remote mode (only when CARLA_MODE=remote):
# CARLA_REMOTE_HOST=...
# CARLA_REMOTE_PORT=22
# CARLA_REMOTE_USER=...
# CARLA_REMOTE_KEY=~/.ssh/...
# Remote-side layout (defaults in tools/carla_remote.py RemoteCfg):
# CARLA_REMOTE_PROJECT_DIR=/home/<user>/leaderboard_2.0
# CARLA_REMOTE_PYTHON=/home/<user>/miniconda3/envs/PCLA/bin/python
# CARLA_REMOTE_RUNS_ROOT=/home/<user>/crash2openx_runs
# CARLA_REMOTE_RUNNER=/home/<user>/crash2openx_runs/runner.sh
# CARLA_REMOTE_CONTAINER=carla-0916
# CARLA_REMOTE_RPC_PORT=2000
